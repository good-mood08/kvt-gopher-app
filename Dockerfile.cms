FROM node:22-slim

WORKDIR /app/apps/cms
ENV NODE_ENV=production

# Fallback toolchain for native modules (e.g. better-sqlite3) if prebuilt binary is unavailable.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY apps/cms/package.json ./
RUN npm install

COPY apps/cms ./

RUN npm run build

EXPOSE 1337

CMD ["npm", "run", "start"]
