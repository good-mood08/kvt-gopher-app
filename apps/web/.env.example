# --- Yandex SpeechKit (приоритет для /api/tts, если заданы ключ и каталог) ---
# Создай ключ в консоли Yandex Cloud; сюда только локальные значения, не коммить реальные ключи.
NUXT_YANDEX_CLOUD_API_KEY=
NUXT_YANDEX_CLOUD_FOLDER_ID=
NUXT_YANDEX_TTS_VOICE=jane
NUXT_YANDEX_TTS_LANG=ru-RU

# Список: https://cloud.yandex.ru/docs/speechkit/tts/voices
NUXT_PUBLIC_TTS_YANDEX_VOICE_PLAYER=filipp
NUXT_PUBLIC_TTS_YANDEX_VOICE_NPC=jane

